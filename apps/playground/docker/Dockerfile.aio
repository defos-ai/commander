# syntax=docker/dockerfile:1
FROM node:24-alpine AS frontend
WORKDIR /src
COPY apps/admin/ui/frontend/package.json apps/admin/ui/frontend/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY apps/admin/ui/frontend/ ./
RUN npm run build

FROM golang:1.26.7-bookworm AS build

WORKDIR /src
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
COPY . .
COPY --from=frontend /src/dist ./apps/admin/ui/backend/static/dist
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    go build -tags embed_ui -trimpath -buildvcs=false -o /out/commander ./apps/playground/cmd/commander

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates chromium fonts-liberation git openssl tini \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd --gid 1000 commander \
    && useradd --uid 1000 --gid 1000 --create-home commander
COPY --from=build /out/commander /usr/local/bin/commander
COPY --chmod=755 apps/playground/docker/entrypoint.aio.sh /usr/local/bin/commander-entrypoint
ENV API_LISTEN_ADDRESS=0.0.0.0:4274 UI_LISTEN_ADDRESS=0.0.0.0:4275 API_RUNTIME=docker MCP_RUNTIME=docker CHROMIUM_NO_SANDBOX=true
EXPOSE 4274 4275
USER 1000:1000
WORKDIR /home/commander
ENTRYPOINT ["/usr/local/bin/commander-entrypoint"]
