# syntax=docker/dockerfile:1
FROM golang:1.26.7-bookworm AS build

WORKDIR /src
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
COPY . .
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    go build -trimpath -buildvcs=false -o /out/commander ./apps/playground/cmd/commander

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates chromium fonts-liberation openssl tini \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd --gid 1000 commander \
    && useradd --uid 1000 --gid 1000 --create-home commander
COPY --from=build /out/commander /usr/local/bin/commander
COPY --chmod=755 apps/playground/docker/entrypoint.aio.sh /usr/local/bin/commander-entrypoint
ENV API_LISTEN_ADDRESS=0.0.0.0:4274 API_RUNTIME=docker MCP_RUNTIME=docker CHROMIUM_NO_SANDBOX=true
EXPOSE 4274
USER 1000:1000
WORKDIR /home/commander
ENTRYPOINT ["/usr/local/bin/commander-entrypoint"]
