{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Commander Controller",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/apps/controllers/default/cmd",
      "cwd": "${workspaceFolder}",
      "buildFlags": "-buildvcs=false",
      "console": "integratedTerminal",
      "env": {
        "BUS_URL": "${workspaceFolder}/state/bus",
        "STORAGE_URL": "${workspaceFolder}/state/storage",
        "DATABASE_URL": "${workspaceFolder}/state/database",
        "LOG_LEVEL": "debug"
      }
    },
    {
      "name": "Commander MCP: attach to running server",
      "type": "go",
      "request": "attach",
      "mode": "local",
      "processId": "${command:pickGoProcess}",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Commander Docker: Controller",
      "type": "go",
      "debugAdapter": "dlv-dap",
      "request": "attach",
      "mode": "remote",
      "host": "127.0.0.1",
      "port": 2345,
      "substitutePath": [
        {
          "from": "${workspaceFolder}",
          "to": "/src"
        }
      ]
    },
    {
      "name": "Commander Docker: API",
      "type": "go",
      "debugAdapter": "dlv-dap",
      "request": "attach",
      "mode": "remote",
      "host": "127.0.0.1",
      "port": 2346,
      "substitutePath": [
        {
          "from": "${workspaceFolder}",
          "to": "/src"
        }
      ]
    },
    {
      "name": "Commander Docker: MCP",
      "type": "go",
      "debugAdapter": "dlv-dap",
      "request": "attach",
      "mode": "remote",
      "host": "127.0.0.1",
      "port": 2347,
      "substitutePath": [
        {
          "from": "${workspaceFolder}",
          "to": "/src"
        }
      ]
    }
  ],
  "compounds": [
    {
      "name": "Commander Docker: All Services",
      "configurations": [
        "Commander Docker: Controller",
        "Commander Docker: API",
        "Commander Docker: MCP"
      ]
    }
  ]
}
